<a:History>ORG {EDBFCAA4-888E-4424-8DF6-0F23411D6163}
DAT 1758184767</a:History>
<a:DataType>VBIN100</a:DataType>
<a:Length>100</a:Length>
<a:GlobalObjectID/>
<c:Domain>
<o:Domain Ref="o792"/>
</c:Domain>
